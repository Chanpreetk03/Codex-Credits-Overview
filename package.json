{
  "name": "codex-rollout-usage-monitor",
  "displayName": "Codex Rollout Insights",
  "description": "Local, privacy-preserving observability for Codex rollout usage.",
  "version": "1.0.0",
  "publisher": "ChanpreetKaur",
  "license": "MIT",
  "icon": "media/marketplace-icon.png",
  "galleryBanner": {
    "color": "#0F172A",
    "theme": "dark"
  },
  "pricing": "Free",
  "keywords": ["codex", "openai", "usage", "tokens", "observability", "privacy"],
  "repository": {
    "type": "git",
    "url": "https://github.com/Chanpreetk03/Codex-Credits-Overview.git"
  },
  "bugs": {
    "url": "https://github.com/Chanpreetk03/Codex-Credits-Overview/issues"
  },
  "homepage": "https://github.com/Chanpreetk03/Codex-Credits-Overview#readme",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:codexUsage.analyzeCurrentSession",
    "onView:codexUsage.dashboard"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codexUsage",
          "title": "Codex Usage",
          "icon": "media/codex-usage.svg"
        }
      ]
    },
    "views": {
      "codexUsage": [
        {
          "type": "webview",
          "id": "codexUsage.dashboard",
          "name": "Usage"
        },
        {
          "type": "tree",
          "id": "codexUsage.sessions",
          "name": "Sessions"
        }
      ]
    },
    "commands": [
      {
        "command": "codexUsage.analyzeCurrentSession",
        "title": "Codex Usage: Analyze Latest Session"
      },
      {
        "command": "codexUsage.openDashboard",
        "title": "Codex Usage: Open Dashboard"
      },
      {
        "command": "codexUsage.refreshHistory",
        "title": "Codex Usage: Refresh Sessions",
        "icon": "$(refresh)"
      },
      {
        "command": "codexUsage.selectSession",
        "title": "Codex Usage: Select Observed Session",
        "icon": "$(list-selection)"
      },
      {
        "command": "codexUsage.selectThread",
        "title": "Codex Usage: Select Session"
      },
      {
        "command": "codexUsage.refreshRateLimits",
        "title": "Codex Usage: Refresh Account Rate Limits"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "codexUsage.refreshHistory",
          "when": "view == codexUsage.dashboard",
          "group": "navigation@1"
        },
        {
          "command": "codexUsage.selectSession",
          "when": "view == codexUsage.dashboard",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Codex Usage",
      "properties": {
        "codexUsage.codexHome": {
          "type": "string",
          "default": "",
          "description": "Codex home directory. Leave empty to auto-detect."
        },
        "codexUsage.enableDebugLogging": {
          "type": "boolean",
          "default": false,
          "description": "Log rollout schema diagnostics without logging prompts or tool output."
        },
        "codexUsage.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show current Codex session total in the status bar."
        },
        "codexUsage.historySessionLimit": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "maximum": 100,
          "description": "Maximum number of most-recent sessions to scan when refreshing session history."
        },
        "codexUsage.showSessionNames": {
          "type": "boolean",
          "default": false,
          "description": "Show local Codex session names. Names can contain prompt-derived text."
        },
        "codexUsage.showPromptPreview": {
          "type": "boolean",
          "default": false,
          "description": "Show a short local preview for each user prompt. Prompt text is otherwise hidden."
        },
        "codexUsage.promptPreviewLength": {
          "type": "number",
          "default": 160,
          "minimum": 1,
          "maximum": 1000,
          "description": "Maximum prompt-preview length when previews are enabled."
        },
        "codexUsage.enableAppServer": {
          "type": "boolean",
          "default": false,
          "description": "Start a separate local Codex app-server to read authoritative account rate limits. This may contact Codex services using your existing Codex sign-in."
        },
        "codexUsage.appServerCommand": {
          "type": "string",
          "default": "codex",
          "description": "Codex executable used only for the opt-in app-server integration."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "test": "npm run compile && node --test out/test/**/*.test.js",
    "analyze": "npm run compile && node out/cli.js",
    "vscode:prepublish": "npm test",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.7.2"
  }
}
